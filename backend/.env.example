APP_ENV=dev
APP_SECRET=replace-with-a-local-secret

# No guardar secretos en Git. Completar solo en .env.local.
DATABASE_URL="mysql://user:password@127.0.0.1:3306/kermesfera?charset=utf8mb4"
DATABASE_SERVER_VERSION="10.4.18-MariaDB"
RATE_LIMIT_ENABLED=0
RATE_LIMIT_DEFAULT_PER_MINUTE=60
IDEMPOTENCY_HEADER=HTTP_IDEMPOTENCY_KEY
INVITATION_TOKEN_SECRET=replace-with-a-dedicated-secret-of-at-least-32-characters
INVITATION_TOKEN_KEY_VERSION=v1
INVITATION_TOKEN_LEGACY_SECRETS={}
AUTH_TOKEN_SECRET=replace-with-a-dedicated-auth-secret-of-at-least-32-characters
AUTH_TOKEN_ISSUER=kermesfera
AUTH_TOKEN_AUDIENCE=kermesfera-api
AUTH_TOKEN_CLOCK_SKEW_SECONDS=30
AUTH_TOKEN_MAX_TTL_SECONDS=3600
